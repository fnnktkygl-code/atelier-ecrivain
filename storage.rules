rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Helper function to check if request is authenticated & matches owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User files scoped strictly by UID
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) && request.resource.size < 10 * 1024 * 1024; // 10MB max
    }

    // Deny all other access by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
