rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if request is authenticated & matches owner
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Helper function to prevent payload abuse
    function isValidPayload() {
      return request.resource == null || request.resource.data.keys().size() < 100;
    }

    // Shared system quotas for multi-user real-time tracking
    match /system/{document=**} {
      allow read, write: if request.auth != null && isValidPayload();
    }

    // User data scoped strictly by UID
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidPayload();

      // Manuscripts subcollection
      match /manuscripts/{manuscriptId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayload();

        // Chapters subcollection
        match /chapters/{chapterId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId) && isValidPayload();
        }

        // Meta subcollection (notes, settings)
        match /meta/{metaId} {
          allow read: if isOwner(userId);
          allow write: if isOwner(userId) && isValidPayload();
        }
      }

      // Profile settings
      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidPayload();
      }
    }

    // Deny all unauthenticated or out-of-scope access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
